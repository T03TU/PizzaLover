# ── Ollama Connection ──
# Mode 1: Host Ollama (default when running `docker compose up`)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Mode 2: Dockerized Ollama (when using `docker compose --profile with-ollama up`)
# OLLAMA_BASE_URL=http://ollama:11434

# ── Model Settings ──
LLM_MODEL=llama3.2
EMBEDDING_MODEL=mxbai-embed-large

# ── Retrieval Settings ──
RETRIEVER_K=3
